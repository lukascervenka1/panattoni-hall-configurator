# Žádná tajemství nejsou pro demo (M0 + M1) potřeba.
# Pozdější milníky (M3+) doplní například:
# DATABASE_URL=            # pooled connection string spravovaného PostgreSQL (serverless)
# ADMIN_AUTH_SECRET=       # tajemství serverové autentizace administrace
# Hodnoty nikdy neukládej do repozitáře ani do NEXT_PUBLIC_* proměnných.

# --- Poptávky (src/inquiry, viz docs/INQUIRY.md) ---------------------------------------------------------------
# Výchozí je demo adaptér "mock": poptávku nikam neodešle ani neuloží a odpověď to otevřeně říká.
# INQUIRY_ADAPTER=mock
#
# Dynamics 365 (Dataverse Web API, entita lead). Skutečné odesílání se nespustí, dokud NENÍ výslovně schváleno
# (INQUIRY_REAL_SEND_APPROVED=yes) a nejsou vyplněny všechny hodnoty. Hodnoty nikdy neukládej do repozitáře
# ani do NEXT_PUBLIC_* proměnných.
# INQUIRY_ADAPTER=dynamics365
# INQUIRY_REAL_SEND_APPROVED=
# DYNAMICS_ORG_URL=            # např. https://org.crm4.dynamics.com
# DYNAMICS_TENANT_ID=          # Microsoft Entra tenant
# DYNAMICS_CLIENT_ID=          # aplikace (aplikační uživatel v Dataverse s právem vytvářet leady)
# DYNAMICS_CLIENT_SECRET=
# Volitelné vlastní pole leadu (logické názvy z vaší organizace); bez nich vše zůstane v popisu leadu:
# DYNAMICS_FIELD_CONFIG_JSON=
# DYNAMICS_FIELD_SUBMISSION_ID=
# DYNAMICS_FIELD_INTENT=
